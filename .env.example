# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ---- Frontend (bundled into the client build; the anon key is public by design,
#      access is enforced by Postgres Row-Level Security, not by keeping this secret) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- One-time migration script only (tooling/migrate-to-supabase.mjs) ----
# This key bypasses Row-Level Security. It must NOT have a VITE_ prefix — Vite
# only bundles VITE_-prefixed vars into the client, so this one never ships to
# the browser as long as that stays true. Never paste it into VITE_SUPABASE_*.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
